{
  "name": "workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@workspace/collab --filter=!@workspace/mcp-server",
    "build": "turbo run build",
    "lint": "biome lint .",
    "typecheck": "turbo run typecheck --concurrency=4",
    "test": "turbo run test --concurrency=8",
    "test:e2e": "playwright test",
    "check": "biome check .",
    "format": "biome format --write .",
    "generate-routes": "turbo run generate-routes",
    "db:migrate": "node scripts/db-migrate-all.mjs",
    "check:design": "node scripts/contrast-check.mjs",
    "seed:demo": "tsx scripts/seed-demo.mts",
    "backup": "node scripts/backup.mjs",
    "dev:collab": "pnpm --filter @workspace/collab dev"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@workspace/config": "workspace:*",
    "@workspace/database": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "tsx": "^4.19.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  }
}
