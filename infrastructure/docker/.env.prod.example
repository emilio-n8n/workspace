# Configuration de production — copier vers .env.prod et remplacer les secrets.
# Ce fichier est lu par docker compose (env_file) et par les applications.

# --- Domaine et TLS ---------------------------------------------------------
# Domaine principal ; les applications vivent sur les sous-domaines
# drive.<domaine>, docs.<domaine>, etc. Créez un enregistrement DNS
# A/AAAA pour le domaine ET un wildcard *.domaine vers le VPS.
PUBLIC_HOST=example.org
PUBLIC_URL=https://example.org
BETTER_AUTH_COOKIE_DOMAIN=.example.org
ACME_EMAIL=admin@example.org

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=workspace
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=workspace
# Doit reprendre le mot de passe ci-dessus et pointer vers le service postgres.
DATABASE_URL=postgres://workspace:change-me-long-random-password@postgres:5432/workspace

# --- Session ----------------------------------------------------------------
# openssl rand -hex 32 — ne jamais réutiliser le secret de développement.
SESSION_SECRET=change-me-please-use-a-random-64-chars-secret-value

# --- Stockage ---------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=/data/storage
#MAX_UPLOAD_BYTES=104857600

# --- Messagerie (optionnel) -------------------------------------------------
#MAIL_DOMAIN=example.org
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
#SMTP_USER=workspace
#SMTP_PASS=change-me
#SMTP_FROM=Workspace <workspace@example.org>
#MAIL_WEBHOOK_SECRET=change-me-please

# --- Visioconférence (optionnel) -------------------------------------------
#LIVEKIT_URL=wss://livekit.example.org
#LIVEKIT_API_KEY=change-me
#LIVEKIT_API_SECRET=change-me-please-use-a-random-secret

# --- Collaboration temps réel Docs (optionnel) ------------------------------
# Sans COLLAB_URL, Docs reste en autosave (dégradation normale).
#COLLAB_URL=wss://collab.example.org
