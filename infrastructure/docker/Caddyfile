# Reverse proxy de production — TLS automatique (Let's Encrypt).
# Variables : PUBLIC_HOST et ACME_EMAIL (voir .env.prod).
{
	email {$ACME_EMAIL}
}

(security) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}

{$PUBLIC_HOST} {
	import security
	encode zstd gzip
	reverse_proxy home:3000
}

