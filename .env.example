# Configuration d'instance — copier vers .env et renseigner.
# Aucun secret réel ne doit être versionné ; ce fichier ne contient que des exemples.

# --- Base de données ---------------------------------------------------------
# Connexion principale (développement ou production).
DATABASE_URL=postgres://workspace:change-me@127.0.0.1:5432/workspace_dev
# Connexion utilisée par les tests d'intégration (base jetable).
TEST_DATABASE_URL=postgres://workspace:change-me@127.0.0.1:5432/workspace_test

# --- Instance ----------------------------------------------------------------
# URL publique de l'application d'accueil (liens d'invitation, partage).
# En production : https://exemple.org
PUBLIC_URL=http://localhost:3000
# Secret de signature des sessions — 32 caractères minimum, unique par instance.
# Générer : openssl rand -hex 24
SESSION_SECRET=change-me-please-use-a-random-64-chars-secret-value

# --- Applications de la suite (optionnel) ------------------------------------
# En développement, les ports 3000-3013 sont utilisés automatiquement
# (3000 accueil · 3001 drive · 3002 docs · 3003 tasks · 3004 calendar
#  3005 forms · 3006 sheets · 3007 slides · 3008 mail · 3009 chat
#  3010 meet · 3011 sites · 3012 classroom · 3013 admin).
# En production, les URLs sont dérivées en sous-domaines de PUBLIC_URL
# (drive.exemple.org, …) ou surchargées explicitement ci-dessous.
#DRIVE_URL=https://drive.exemple.org
#DOCS_URL=https://docs.exemple.org
#TASKS_URL=https://tasks.exemple.org
#CALENDAR_URL=https://calendar.exemple.org
#FORMS_URL=https://forms.exemple.org
#SHEETS_URL=https://sheets.exemple.org
#SLIDES_URL=https://slides.exemple.org
#MAIL_URL=https://mail.exemple.org
#CHAT_URL=https://chat.exemple.org
#MEET_URL=https://meet.exemple.org
#SITES_URL=https://sites.exemple.org
#CLASSROOM_URL=https://classroom.exemple.org
#ADMIN_URL=https://admin.exemple.org
# Serveur de collaboration temps réel (Yjs) des Documents : sans URL,
# l'édition reste sur l'autosave (dégradation normale, pas d'erreur).
#COLLAB_URL=ws://localhost:3100
# Port d'écoute du serveur de collaboration (défaut : 3100).
#COLLAB_PORT=3100
# Cookie de session partagé entre sous-domaines (production) :
#BETTER_AUTH_COOKIE_DOMAIN=.exemple.org

# --- Messagerie (optionnel) ---------------------------------------------------
# Domaine des adresses locales des boîtes (ex. exemple.org). Sans valeur,
# les adresses utilisent le domaine de PUBLIC_URL.
#MAIL_DOMAIN=exemple.org
# Relais SMTP sortant (sans configuration, les envois restent dans la boîte
# d'envoi locale avec une erreur explicite).
#SMTP_HOST=smtp.exemple.org
#SMTP_PORT=587
#SMTP_USER=workspace
#SMTP_PASS=change-me
#SMTP_FROM=Workspace <workspace@exemple.org>
# Secret partagé du webhook d'ingestion du courrier entrant (MX → POST).
#MAIL_WEBHOOK_SECRET=change-me-please

# --- Visioconférence (optionnel, ADR-0011) ------------------------------------
# Sans serveur LiveKit configuré, les salles fonctionnent en mode « lien seul ».
#LIVEKIT_URL=wss://livekit.exemple.org
#LIVEKIT_API_KEY=change-me
#LIVEKIT_API_SECRET=change-me-please-use-a-random-secret

# --- Stockage des fichiers ---------------------------------------------------
# local (défaut) | s3
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
# Requis si STORAGE_DRIVER=s3 (MinIO, Garage, Ceph, AWS…)
#S3_ENDPOINT=https://s3.example.org
#S3_BUCKET=workspace
#S3_REGION=eu-west-1
#S3_ACCESS_KEY=change-me
#S3_SECRET_KEY=change-me

# --- Limites -----------------------------------------------------------------
# Taille maximale d'un upload (octets). Défaut : 100 Mo.
#MAX_UPLOAD_BYTES=104857600
