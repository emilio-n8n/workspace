# Configuration d'instance — copier vers .env et renseigner.
# Aucun secret réel ne doit être versionné ; ce fichier ne contient que des exemples.

# --- Base de données ---------------------------------------------------------
# Connexion principale (développement ou production).
DATABASE_URL=postgres://workspace:change-me@127.0.0.1:5432/workspace_dev
# Connexion utilisée par les tests d'intégration (base jetable).
TEST_DATABASE_URL=postgres://workspace:change-me@127.0.0.1:5432/workspace_test

# --- Instance ----------------------------------------------------------------
# URL publique (liens d'invitation, partage). En production : https://…
PUBLIC_URL=http://localhost:3000
# Secret de signature des sessions — 32 caractères minimum, unique par instance.
# Générer : openssl rand -hex 24
SESSION_SECRET=change-me-please-use-a-random-64-chars-secret-value

# --- Stockage des fichiers ---------------------------------------------------
# local (défaut) | s3
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
# Requis si STORAGE_DRIVER=s3 (MinIO, Garage, Ceph, AWS…)
#S3_ENDPOINT=https://s3.example.org
#S3_BUCKET=workspace
#S3_REGION=eu-west-1
#S3_ACCESS_KEY=change-me
#S3_SECRET_KEY=change-me

# --- Limites -----------------------------------------------------------------
# Taille maximale d'un upload (octets). Défaut : 100 Mo.
#MAX_UPLOAD_BYTES=104857600
