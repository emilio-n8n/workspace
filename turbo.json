{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".output/**",
        ".nitro/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate-routes": {},
    "lint": {},
    "typecheck": {},
    "test": {}
  },
  "envMode": "loose",
  "globalPassThroughEnv": [
    "DEMO_SEED_ALLOW_REMOTE"
  ],
  "concurrency": "20"
}
