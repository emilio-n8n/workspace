{
  "name": "@workspace/sync-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client de synchronisation local Workspace Drive (two-way, upload, download).",
  "bin": {
    "workspace-sync": "./dist/cli.mjs"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
